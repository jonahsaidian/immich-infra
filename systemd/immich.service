[Unit]
Description=Immich stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/photos
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/immich-infra
EnvironmentFile=/opt/immich-infra/.env
ExecStartPre=/opt/immich-infra/scripts/check-library-mount.sh
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
# If the drive isn't mounted yet, the pre-check fails and systemd retries
# every 30s indefinitely (StartLimitIntervalSec=0 disables the burst
# limit) -- this is the "wait for the drive" behavior, not a one-shot fail.
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
