[Unit]
Description=Immich photo server (gated on external photo drive)
Documentation=https://github.com/jonahsaidian/immich-infra
# Ordering only -- deliberately no Requires= here. Every failure mode
# (docker down, drive missing/slow) surfaces as a non-zero exit from
# ExecStartPre/ExecStart, which Restart=on-failure provably retries.
# A hard Requires=mnt-photos.mount could fail the unit via dependency
# failure instead, which is not guaranteed to trigger a restart --
# exactly the boot-without-drive case this unit exists to survive.
After=docker.service mnt-photos.mount network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/jonah/immich-infra
# Mount-guard: refuse to start unless the external drive is mounted.
# The canary proves it is *our* drive, not an empty mountpoint.
ExecStartPre=/usr/bin/test -f /mnt/photos/.immich-library-marker
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=180
# If the drive isn't there yet, retry every 30s until it appears.
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
