# Pin explicitly and bump deliberately -- auto-deploy will not update this
# for you, so this is also your security-patch checkpoint.
IMMICH_VERSION=v1.118.2

# Library location -- must be the external HDD mount point, never the
# internal disk. scripts/check-library-mount.sh guards against this.
IMMICH_LIBRARY_PATH=/mnt/photos

DB_USERNAME=immich
DB_PASSWORD=
DB_DATABASE_NAME=immich
